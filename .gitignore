# =============================================================================

data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep

# Metadata обычно небольшая и может храниться в Git
# Если позже появятся большие файлы, правило можно изменить.

